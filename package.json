{
  "name": "jingyun-dsh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:deps": "node scripts/build_deps.js",
    "dev": "concurrently -n \"bundle,server\" -c \"cyan,green\" \"pnpm -C packages/jingyun-dsh dev\" \"node scripts/prepare_dev.js && node --watch --watch-path=packages/jingyun-dsh/lib node_modules/@deepseek-ai/dsh/lib/bin.js --profile web\"",
    "watch": "pnpm -C packages/jingyun-dsh dev",
    "start": "node scripts/prepare_dev.js && node node_modules/@deepseek-ai/dsh/lib/bin.js --profile web",
    "tauri:dev": "npx --package @tauri-apps/cli tauri dev",
    "tauri:build": "pnpm build && node scripts/prepare_vendor.js && npx --package @tauri-apps/cli tauri build",
    "lint": "oxlint",
    "fmt": "oxfmt --write"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.8",
    "@jingyun-ai/jingyun-dsh": "workspace:^",
    "@types/qrcode.react": "^3.0.0",
    "cordis": "^3.0.0",
    "qrcode.react": "^4.2.0",
    "ws": "^8.18.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^20.0.0",
    "concurrently": "^10.0.5",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.5.0"
  }
}
