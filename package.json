{
  "name": "jingyun-dsh",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:deps": "node scripts/build_deps.js",
    "download:runtimes": "node scripts/download_runtimes.js",
    "dev": "concurrently -n \"bundle,server\" -c \"cyan,green\" \"pnpm -C packages/jingyun-dsh dev\" \"node scripts/prepare_dev.js && node --watch --watch-path=packages/jingyun-dsh/lib node_modules/@deepseek-ai/dsh/lib/bin.js --profile web --no-open\"",
    "watch": "pnpm -C packages/jingyun-dsh dev",
    "start": "node scripts/prepare_dev.js && node node_modules/@deepseek-ai/dsh/lib/bin.js --profile web",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint": "oxlint --fix",
    "fmt": "oxfmt --write",
    "typecheck": "tsc -b --noEmit",
    "cargo": "cd src-tauri && cargo",
    "release": "bumpp package.json packages/jingyun-dsh/package.json src-tauri/tauri.conf.json src-tauri/Cargo.toml -x \"cargo update -p jingyun-dsh-client --manifest-path src-tauri/Cargo.toml\" --all"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.8",
    "@jingyun-ai/jingyun-dsh": "workspace:^",
    "cordis": "^3.0.0",
    "qrcode.react": "^4.2.0",
    "ws": "^8.18.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^26.4.1",
    "bumpp": "^12.2.3",
    "concurrently": "^10.0.5",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.80.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.5.0"
  }
}
