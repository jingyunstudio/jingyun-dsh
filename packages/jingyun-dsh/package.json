{
  "name": "@jingyun-ai/jingyun-dsh",
  "version": "0.1.16",
  "description": "Branding customization plugin for DSH client",
  "keywords": [
    "ai-agent",
    "deepseek-harness",
    "dsh-plugin",
    "jingyun",
    "jingyun.studio",
    "tauri"
  ],
  "homepage": "https://github.com/jingyunstudio/jingyun-dsh#readme",
  "bugs": {
    "url": "https://github.com/jingyunstudio/jingyun-dsh/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jingyunstudio/jingyun-dsh.git",
    "directory": "packages/jingyun-dsh"
  },
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-commands": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-commands"
      ],
      "platform": "web"
    }
  }
}
