{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "printWidth": 80,
  "sortPackageJson": true,
  "sortImports": {
    "order": "asc",
    "internalPattern": ["~/", "@/"],
    "groups": [
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ],
    "customGroups": []
  },
  "ignorePatterns": ["*.md", "*.toml"]
}
